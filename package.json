{
  "name": "aalopp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "content:check": "tsx scripts/validate-content.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && rm -rf .next && next build",
    "db:seed": "tsx --env-file=.env.local prisma/seed.ts",
    "content:generate": "tsx scripts/generate/index.ts",
    "content:ingest": "tsx scripts/ingest/index.ts",
    "assets:fetch": "tsx scripts/fetch-assets.ts",
    "maps:build": "tsx scripts/maps/build-maps.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "d3-geo": "^3.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pdfjs-dist": "6.3.289",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
