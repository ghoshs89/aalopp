// Questions and skills live in content/*.json, so attempts reference them by id rather than by foreign key.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ScratchpadMode {
  NONE
  DIGITAL
  PAPER
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

model Student {
  id        String            @id @default(uuid())
  name      String
  avatar    String
  createdAt DateTime          @default(now())
  sessions  PracticeSession[]
  attempts  Attempt[]
}

model PracticeSession {
  // Generated on the device so answers can be queued offline and uploaded later without duplicates.
  id        String    @id
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?
  attempts  Attempt[]

  @@index([studentId, startedAt])
}

model Attempt {
  id            String          @id
  studentId     String
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId     String
  session       PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId    String
  response      Json
  isCorrect     Boolean
  confidence    Confidence?
  firstActionMs Int?
  totalMs       Int
  listenCount   Int             @default(0)
  answeredAt    DateTime
  /// Calendar date on the device when answered (YYYY-MM-DD), in the household's time zone.
  localDate     String?
  /// Why the selector picked this question, shown on the grown-ups page.
  selectionReason String?
  /// NONE, DIGITAL (drew on the scratchpad) or PAPER (said they worked on paper). Drawings are not stored.
  scratchpad    ScratchpadMode?
  scratchpadStrokes Int?
  receivedAt    DateTime        @default(now())

  @@index([studentId, answeredAt])
  @@index([sessionId])
}
